# Secrets & local data — never commit
.env
sentinel.db
sentinel.db.*

# Python
__pycache__/
*.pyc

# Editor/save artifacts
*.save

# Every ad-hoc backup naming pattern currently in use for the two
# live scripts (.bak, .backup, .backup_consensus, .before_X,
# _backup_TIMESTAMP.py, etc.) — verified against the actual project
# folder to catch all 44 stray snapshot files without touching the
# real sentinel_ai.py / sentinel_stage1.py.
sentinel_ai.py.*
sentinel_ai_*backup*.py
sentinel_stage1.py.*
sentinel_stage1_*backup*.py
backups/

# Captured terminal transcripts (e.g. output redirected to a file
# named "performance") — logs, not source or data.
performance
*.log

# HEX SENTINEL Historical Market Warehouse — local only
historical_data/
data/
datasets/
*.csv
*.zip
*.parquet

# General catch-all for the "before_X" and "backup" naming
# convention seen beyond just sentinel_ai/sentinel_stage1 — e.g.
# portfolio_walk_forward_validation.py.before_schema_fix, and
# anything similar you create for other files going forward.
*.before_*
*_backup_*.py
*.backup_*

# Scratch/working audit output — not the final report.
audit_baseline/
claude_audit/
hex_audit.txt
*.db
*.bak*
lab_charts/
charts/
band
hband
